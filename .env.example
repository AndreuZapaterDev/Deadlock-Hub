# Clave de la Deadlock API (opcional). Sin ella se aplica el límite por IP (≈200 peticiones/min); con ella, el más alto.
DEADLOCK_API_KEY=
# Clave de Steam Web API (opcional, solo para "Iniciar sesión con Steam", que aún no está hecho).
STEAM_API_KEY=
# URL pública de la web (SEO, sitemap e imágenes Open Graph).
NEXT_PUBLIC_SITE_URL=https://deadlockhub.vercel.app
# Opcional: idioma de los textos del juego si el usuario no ha elegido uno (por defecto, spanish).
# DEADLOCK_API_LANGUAGE=spanish
